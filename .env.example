# Backend
DB_URL=jdbc:postgresql://localhost:5432/campvivo
DB_USERNAME=campvivo
DB_PASSWORD=changeme
# >= 32 ký tự
JWT_SECRET=change_this_in_real_env_min_32_chars
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# VNPay sandbox (D-08, D-28) — chỉ backend đọc. VNP_URL bỏ trống = sandbox mặc định.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trang kết quả ở frontend (production: https://<domain>/payment/vnpay-return)
VNP_RETURN_URL=http://localhost:3000/payment/vnpay-return
# Chỉ để ghi lại — IPN URL thật khai báo ở cổng merchant VNPay: https://<backend>/api/vnpay/ipn
# VNP_IPN_URL=
# GHN staging (D-27) — lấy ở https://5sao.ghn.dev → Chủ cửa hàng → Token API, mã cửa hàng; mã quận/phường kho gửi.
# Chỉ backend đọc các biến này (không bao giờ đặt tiền tố NEXT_PUBLIC_). Giá trị số không để trong nháy.
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=
GHN_SERVICE_TYPE_ID=2
# Cân nặng mỗi món (gram) khi sản phẩm chưa có cân nặng riêng
GHN_DEFAULT_WEIGHT=500
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SMTP (gửi OTP/email). Mặc định trỏ Mailpit chạy bằng docker compose (localhost:1025, xem thư ở http://localhost:8025).
# ĐỪNG khai biến rỗng: biến rỗng ghi đè mặc định. Chỉ bỏ comment và điền khi dùng SMTP thật (vd. Gmail App Password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true

# Deploy (tuỳ chọn): origin frontend được gọi API, URL frontend trong email, cổng backend
# APP_CORS_ALLOWED_ORIGINS=https://campvivo.example.com
# APP_FRONTEND_URL=https://campvivo.example.com
# PORT=8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
