# Copy thành application-dev.yml (KHÔNG commit file đã điền secret thật)
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/campvivo
    username: campvivo
    password: changeme
  jpa:
    hibernate:
      # Dùng "none" nếu entity chưa khớp migration (đến khi F-05 xong); mặc định ở application.yml là validate
      ddl-auto: validate
    show-sql: true
  flyway:
    enabled: true
app:
  jwt:
    # >= 32 ký tự (HS256). Thiếu hoặc ngắn hơn thì app không khởi động.
    secret: dev_only_secret_change_me_at_least_32_chars
    ttl: 24h
