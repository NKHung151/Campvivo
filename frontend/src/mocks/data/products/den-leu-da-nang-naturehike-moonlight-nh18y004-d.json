i> </ul> <p><img alt=\"\" height=\"1000\" loading=\"lazy\" src=\"https://wetrek.vn/pic/products/images/den-neu-naturehike-10016%20(2).jpeg\" width=\"1000\"></p>","specsHtml":"<p><strong>ĐẶC TÍNH SẢN PHẨM:</strong></p> <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%\"> <tbody> <tr> <td><strong>Thương hiệu</strong></td> <td>Naturehike</td> </tr> <tr> <td><strong>Xuất xứ</strong></td> <td>Trung Quốc</td> </tr> <tr> <td><strong>Mã sản phẩm</strong></td> <td>NH18Y004-D</td> </tr> <tr> <td><strong>Kích thước</strong></td> <td>12,2 x 8,9 x 2,6cm</td> </tr> <tr> <td><strong>Trọng lượng</strong></td> <td>0,340kg</td> </tr> <tr> <td><strong>Công suất</strong></td> <td>36W</td> </tr> <tr> <td><strong>Lumen</strong></td> <td>1800LM (tối đa)</td> </tr> <tr> <td><strong>Pin</strong></td> <td>15000mAh / 3.7V 33.3Wh</td> </tr> <tr> <td><strong>Thời gian sử dụng</strong></td> <td>7 - 180 giờ.</td> </tr> <tr> <td><strong>Chế độ</strong></td> <td>Ánh sáng trắng, Ánh sáng tự nhiên, Ánh sáng ấm, SOS</td> </tr> <tr> <td><strong>Chất liệu</strong></td> <td>ABS / PC</td> </tr> </tbody> </table>","guideHtml":null,"reviews":[],"social":{"sold":132,"rating":null,"satisf":null},"fbt":[{"name":"Đèn treo lều chống nước pin 3A Naturehike Camp Lamp NH16D300-D - 9647","price":200000,"disc":"","img":"https://wetrek.vn/pic/products/9647-2_638828363603086577.jpg.ashx?w=240&q=80","link":"/products/den-treo-leu-chong-nuoc-naturehike-lantern-led-waterproof-camping-tent-light-nh16d300-d-9647","rating":0,"sold":2046},{"name":"Đèn Led măng xông Retro Lamp TM-LY02","price":350000,"disc":"","img":"https://wetrek.vn/pic/products/tbd0603145601a_638518162227456573.jpg.ashx?w=240&q=80","link":"/products/den-led-mang-xong-retro-lamp-tm-ly02","rating":5,"sold":1584},{"name":"Đèn cắm trại Barebones Beacon Hanging Light","price":1530000,"disc":"","img":"https://wetrek.vn/pic/products/beacon-dustyyellow_pdp_01_cca094_638781665635510910.jpg.ashx?w=240&q=80","link":"/products/den-cam-trai-bare