àn và tự tin khi bạn chạy qua những đường địa hình khó khăn. Đây là lựa chọn hoàn hảo cho những người chạy bộ yêu thích những cuộc phiêu lưu đầy thách thức.</p> <p><img alt=\"\" height=\"809\" loading=\"lazy\" src=\"https://wetrek.vn/pic/Product/images/xzwyhmwx6zdeyz1namib%20copy3.jpg\" width=\"1000\"></p>","specsHtml":"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%\"> <tbody> <tr> <td><strong>Thương hiệu</strong></td> <td>ON Running</td> </tr> <tr> <td><strong>Xuất xứ thương hiệu</strong></td> <td>Thụy Sĩ</td> </tr> <tr> <td><strong>Model</strong></td> <td>Cloudrunner</td> </tr> <tr> <td><strong>Hoạt động</strong></td> <td>Chạy đường phố, chạy đường mòn</td> </tr> <tr> <td><strong>Chất liệu</strong></td> <td>Đế giữa: bọt Helion,Đế ngoài: Cao su Missiongrip</td> </tr> <tr> <td><strong>Trọng lượng (Đôi)</strong></td> <td>280g</td> </tr> <tr> <td><strong>Độ chênh gót</strong></td> <td>9mm</td> </tr> </tbody> </table>","guideHtml":"<p><strong>BẢNG SIZE GIÀY ON:</strong></p> <p><img alt=\"\" height=\"1283\" loading=\"lazy\" src=\"https://wetrek.vn/pic/Product/images/SIZE_GIAY_ON_NAM_2048x2048.jpg\" width=\"1000\"></p>","reviews":[{"name":"Nguyễn Đoàn Tấn Dũng","date":"14/11/2024 - 16:29","rating":5,"text":"Đi rất thích, giày thoải mái"}],"social":{"sold":66,"rating":5,"satisf":100},"fbt":[{"name":"Giày chạy trail nam Humtto Trail Running Shoes 840090A-4","price":999000,"disc":"-17%","img":"/assets/pic/products/6706343f-f4bc-442e-9f28-26472cd017c8.jpg","link":"/products/giay-chay-trail-humtto-trail-running-shoes-840090a-4","rating":5,"sold":1584},{"name":"Giày chạy Humtto Trail Running Dial Shoes 850930A-3","price":999000,"disc":"-23%","img":"https://wetrek.vn/pic/products/850930a-31_638561144314332298.jpg.ashx?w=240&q=80","link":"/products/giay-chay-humtto-trail-running-dial-shoes-850930a-3","rating":0,"sold":1023},{"name":"Giày chạy trail Clorts Trail Running 3F072D","price":1725000,"disc":"","img":"https://wetrek.vn/pic/products/img_1945_63